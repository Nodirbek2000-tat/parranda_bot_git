# Ushbu fayldan nusxa olib, .env nomi bilan saqlang va qiymatlarni to'ldiring.
# .env fayli git ga qo'shilmaydi. Haqiqiy tokenlarni bu faylga yozmang.

# Telegram bot tokeni (@BotFather beradi). Majburiy.
BOT_TOKEN=

# Bot ishga tushgani haqida xabar oladigan Telegram ID lar, vergul bilan: 12345678,87654321
# Bo'sh qoldirish mumkin.
ADMINS=

# Xosting IP manzili (ixtiyoriy).
ip=localhost

# Django API manzili, oxirida "/" belgisisiz.
API_URL=http://127.0.0.1:8000/api

# Backend bilan umumiy maxfiy kalit. parranda_backend/.env dagi BOT_API_TOKEN bilan
# AYNAN bir xil bo'lishi shart, aks holda backend 403 qaytaradi. Majburiy.
BOT_API_TOKEN=

# Web App (Next.js) ning ochiq https manzili, masalan: https://abcd-1-2-3-4.ngrok-free.app
# Telegram faqat https manzillarni ochadi. Bo'sh bo'lsa, "Platformani ochish" tugmalari chiqmaydi.
WEBAPP_URL=
